    {
        "id": "872ae01f92346d43",
        "type": "ui_template",
        "z": "f9120dfc49ef7a61",
        "group": "4f9fec7a8dea7f92",
        "name": "",
        "order": 7,
        "width": 0,
        "height": 0,
        "format": "<div\n    style=\"background: #1a1a1a; padding: 20px; border-radius: 15px; color: white; text-align: center; border: 2px solid #00bcff; font-family: sans-serif;\">\n    <h2 style=\"color: #00bcff; margin-bottom: 5px;\">Health Monitor Sync</h2>\n    <p style=\"font-size: 0.9em; color: #aaa;\">Direct Bluetooth Connection</p>\n\n    <button ng-click=\"connectBLE()\" style=\"background: #00bcff; color: black; border: none; padding: 15px 30px; border-radius: 50px; cursor: pointer; font-weight: bold; font-size: 16px; box-shadow: 0 4px 15px rgba(0,188,255,0.3);\">\n        🔵 Connect Device\n    </button>\n\n    <div id=\"btStatus\" style=\"margin-top: 20px; font-weight: bold; color: #f1c40f;\">Status: Ready</div>\n</div>\n\n<script>\n    (function(scope) {\n    scope.connectBLE = function() {\n        const status = document.getElementById('btStatus');\n        \n        // استخدام المعرفات اللي في كود الأردوينو بتاعك\n        const serviceUuid = \"4fafc201-1fb5-459e-8fcc-c5c9c331914b\";\n        const charUuid = \"beb5483e-36e1-4688-b7f5-ea07361b26a8\";\n\n        status.innerText = \"Searching for ESP32...\";\n\n        navigator.bluetooth.requestDevice({\n            acceptAllDevices: true,\n            optionalServices: [serviceUuid]\n        })\n        .then(device => {\n            status.innerText = \"Found! Connecting...\";\n            return device.gatt.connect();\n        })\n        .then(server => server.getPrimaryService(serviceUuid))\n        .then(service => service.getCharacteristic(charUuid))\n        .then(characteristic => {\n            status.innerText = \"Connected! Waiting for data...\";\n            status.style.color = \"#00ff88\";\n            \n            return characteristic.startNotifications().then(_ => {\n                characteristic.addEventListener('characteristicvaluechanged', event => {\n                    const decoder = new TextDecoder('utf-8');\n                    const value = decoder.decode(event.target.value);\n                    \n                    // إرسال الداتا للـ Node-RED (هتوصل كـ payload)\n                    scope.send({payload: value});\n                });\n            });\n        })\n        .catch(error => {\n            status.innerText = \"Error: \" + error.message;\n            status.style.color = \"#ff4d4d\";\n        });\n    };\n})(scope);\n</script>",
