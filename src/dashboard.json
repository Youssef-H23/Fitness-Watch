        "format": "<div style=\"\ndisplay:flex;\njustify-content:center;\nalign-items:center;\nheight:280px;\n\">\n\n    <div class=\"spo2-container\">\n\n        <div class=\"spo2-icon\">🫁</div>\n\n        <div class=\"spo2-title\">Blood Oxygen</div>\n\n        <div class=\"spo2-value\">\n            {{msg.payload || \"--\"}}\n        </div>\n\n        <div class=\"spo2-unit\">SpO₂ %</div>\n\n    </div>\n\n</div>\n\n<style>\n    .spo2-container {\n        width: 220px;\n        height: 220px;\n        border-radius: 50%;\n\n        background: radial-gradient(circle,\n                #003b5c 20%,\n                #0077b6 60%,\n                #00b4d8 100%);\n\n        display: flex;\n        flex-direction: column;\n        justify-content: center;\n        align-items: center;\n\n        color: white;\n\n        border: 8px solid #90e0ef;\n\n        box-shadow:\n            0 0 20px rgba(144, 224, 239, 0.4);\n\n        animation: breathe 3s infinite ease-in-out;\n    }\n\n    .spo2-icon {\n        font-size: 28px;\n        margin-bottom: 8px;\n    }\n\n    .spo2-title {\n        font-size: 20px;\n        margin-bottom: 10px;\n    }\n\n    .spo2-value {\n        font-size: 55px;\n        font-weight: bold;\n    }\n\n    .spo2-unit {\n        font-size: 18px;\n        color: #caf0f8;\n    }\n\n    @keyframes breathe {\n        0% {\n            transform: scale(1);\n        }\n\n        50% {\n            transform: scale(1.03);\n        }\n\n        100% {\n            transform: scale(1);\n        }\n    }\n</style>",
