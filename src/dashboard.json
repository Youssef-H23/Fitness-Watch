    {
        "id": "b3211933f2296e3f",
        "type": "ui_template",
        "z": "ca447f58e3bfd497",
        "group": "f81a482830b8ac9d",
        "name": "HR chart templete",
        "order": 3,
        "width": 0,
        "height": 0,
        "format": "<div style=\"\nbackground:#f8fafc;\npadding:10px;\nborder-radius:20px;\nwidth:100%;\nheight:320px;\noverflow:hidden;\ndisplay:flex;\nflex-direction:column;\nalign-items:center;\ngap:8px;\n\">\n\n<div style=\"display:flex;justify-content:space-between;align-items:center;width:100%;padding:0 10px;box-sizing:border-box\">\n  <div>\n    <span id=\"bpmNum\" style=\"font-size:40px;font-weight:600;color:#1e293b;line-height:1\">--</span>\n    <span style=\"font-size:13px;color:#94a3b8;margin-left:4px\">BPM</span>\n  </div>\n  <div style=\"text-align:right\">\n    <div style=\"display:flex;align-items:center;gap:5px;justify-content:flex-end\">\n      <div id=\"liveDot\" style=\"width:7px;height:7px;border-radius:50%;background:#94a3b8\"></div>\n      <span id=\"liveStatus\" style=\"font-size:12px;color:#64748b\">Waiting...</span>\n    </div>\n    <div style=\"font-size:11px;color:#94a3b8;font-family:monospace\">α = <span id=\"alphaVal\">--</span></div>\n  </div>\n</div>\n\n<canvas id=\"heartCanvas\" width=\"420\" height=\"200\"></canvas>\n\n<div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;width:100%;border-top:1px solid #e2e8f0\">\n  <div style=\"padding:6px;text-align:center;border-right:1px solid #e2e8f0\">\n    <div style=\"font-size:10px;color:#94a3b8;text-transform:uppercase\">Zone</div>\n    <div id=\"zoneVal\" style=\"font-size:13px;font-weight:600;color:#1e293b\">—</div>\n  </div>\n  <div style=\"padding:6px;text-align:center;border-right:1px solid #e2e8f0\">\n    <div style=\"font-size:10px;color:#94a3b8;text-transform:uppercase\">R-R</div>\n    <div id=\"rrVal\" style=\"font-size:13px;font-weight:600;color:#1e293b\">— ms</div>\n  </div>\n  <div style=\"padding:6px;text-align:center\">\n    <div style=\"font-size:10px;color:#94a3b8;text-transform:uppercase\">Intensity</div>\n    <div id=\"intensityVal\" style=\"font-size:13px;font-weight:600;color:#1e293b\">—</div>\n  </div>\n</div>\n\n</div>\n\n<script>\n(function(scope){\n\nconst canvas = document.getElementById('heartCanvas');\nconst ctx    = canvas.getContext('2d');\nconst W = 420, H = 200;\nconst cx = W/2, cy = H * 0.56;\nconst scX = W * 0.125, scY = H * 0.155;\n\nlet heartRate  = 0;\nlet alpha      = 0;\nlet pulsePhase = 0;\nlet lastBeat   = 0;\n\nfunction bpmToAlpha(bpm){\n  return 4 + (bpm - 40) * (30 - 4) / (180 - 40);\n}\n\nfunction updateMeta(bpm){\n  heartRate = bpm;\n  document.getElementById('bpmNum').textContent = bpm > 0 ? bpm : '--';\n  document.getElementById('rrVal').textContent  = bpm > 0 ? Math.round(60000/bpm)+' ms' : '— ms';\n\n  let zone, intensity, dotColor, status;\n  if(bpm <= 0){\n    zone='—'; intensity='—'; dotColor='#94a3b8'; status='Waiting...';\n  } else if(bpm < 60){\n    zone='Rest'; intensity='Low'; dotColor='#3b82f6'; status='Bradycardia';\n  } else if(bpm < 100){\n    zone='Resting'; intensity='Normal'; dotColor='#22c55e'; status='Normal';\n  } else if(bpm < 140){\n    zone='Cardio'; intensity='High'; dotColor='#f59e0b'; status='Elevated';\n  } else {\n    zone='Peak'; intensity='Max'; dotColor='#ef4444'; status='Tachycardia';\n  }\n\n  document.getElementById('zoneVal').textContent      = zone;\n  document.getElementById('intensityVal').textContent = intensity;\n  document.getElementById('liveStatus').textContent   = status;\n  document.getElementById('liveDot').style.background = dotColor;\n}\n\nfunction animate(ts){\n  if(heartRate > 0){\n    const period = 60000 / heartRate;\n    if(!lastBeat) lastBeat = ts;\n    pulsePhase = ((ts - lastBeat) % period) / period;\n  }\n\n  const baseAlpha = heartRate > 0 ? bpmToAlpha(heartRate) : 8;\n  const envelope  = Math.pow(Math.sin(pulsePhase * Math.PI), 1.5);\n  const target    = baseAlpha * (0.6 + 0.4 * envelope);\n  alpha          += (target - alpha) * 0.12;\n\n  const scaleEnv = 1 + 0.06 * Math.pow(Math.sin(pulsePhase * Math.PI), 2);\n\n  const t = heartRate > 0 ? Math.min(1,(heartRate-40)/140) : 0;\n  const r = Math.round(210 + t*45);\n  const g = Math.round(80  - t*60);\n  const b = Math.round(100 - t*70);\n\n  ctx.clearRect(0,0,W,H);\n\n  // Grid\n  ctx.strokeStyle='rgba(150,150,150,0.12)';\n  ctx.lineWidth=0.5;\n  for(let x=0;x<W;x+=28){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke()}\n  for(let y=0;y<H;y+=28){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke()}\n  ctx.strokeStyle='rgba(150,150,150,0.25)';\n  ctx.lineWidth=1;\n  ctx.beginPath();ctx.moveTo(0,cy);ctx.lineTo(W,cy);ctx.stroke();\n  ctx.beginPath();ctx.moveTo(cx,0);ctx.lineTo(cx,H);ctx.stroke();\n\n  // Heart\n  ctx.beginPath();\n  for(let x=-1.82;x<=1.82;x+=0.007){\n    const y = Math.pow(Math.abs(x),2/3)\n             + 0.9*Math.sqrt(Math.max(0,3.3-x*x))\n             * Math.sin(alpha*Math.PI*x);\n    const px = cx + x*scX*scaleEnv;\n    const py = cy - y*scY*scaleEnv;\n    if(x<=-1.815) ctx.moveTo(px,py);\n    else          ctx.lineTo(px,py);\n  }\n  ctx.strokeStyle=`rgb(${r},${g},${b})`;\n  ctx.lineWidth=2;\n  ctx.lineJoin='round';\n  ctx.stroke();\nctx.fillText(\"Time (s)\",340,115);\nctx.fillText(\"Pulse Intensity\",220,20);\n  // Glow on beat peak\n  if(envelope > 0.6){\n    ctx.save();\n    ctx.globalAlpha=(envelope-0.6)*0.2;\n    ctx.lineWidth=6;\n    ctx.stroke();\n    ctx.restore();\n  }\n\n  document.getElementById('alphaVal').textContent = alpha.toFixed(1);\n  requestAnimationFrame(animate);\n}\nrequestAnimationFrame(animate);\n\n// ✅ هنا بيجي الـ BPM من الـ MQTT\nscope.$watch('msg', function(msg){\n  if(msg && msg.payload !== undefined){\n    var bpm = parseInt(msg.payload);\n    if(bpm > 0 && bpm < 250){\n      updateMeta(bpm);\n    } else {\n      updateMeta(0);\n    }\n  }\n});\n\n})(scope);\n</script>",
