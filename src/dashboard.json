    {
        "id": "65be46af14730e17",
        "type": "ui_template",
        "z": "ca447f58e3bfd497",
        "group": "f81a482830b8ac9d",
        "name": "Emergency Alert",
        "order": 1,
        "width": 0,
        "height": 0,
        "format": "<div id=\"alertBox\" style=\"\ndisplay:none;\npadding:18px;\nborder-radius:15px;\ncolor:white;\nfont-weight:bold;\ntext-align:center;\nmargin:10px;\nfont-size:20px;\nmin-height:60px;\nwidth:90%;\nbox-sizing:border-box;\nline-height:1.4;\nword-wrap:break-word;\n\">\n</div>\n\n<script>\n(function(scope){\n\nlet lastState = \"Normal\";\n\nfunction speakAlert(message){\n    let speech = new SpeechSynthesisUtterance(message);\n\n    speech.lang = \"en-US\";\n    speech.rate = 1;\n    speech.pitch = 1;\n    speech.volume = 1;\n\n    window.speechSynthesis.cancel();\n    window.speechSynthesis.speak(speech);\n}\n\nscope.$watch('msg', function(msg){\n\n    if(!msg || !msg.payload) return;\n\n    let box = document.getElementById(\"alertBox\");\n    let data = msg.payload;\n\n    if(data.state === \"Normal\"){\n        box.style.display = \"none\";\n        lastState = \"Normal\";\n        return;\n    }\n\n    box.style.display = \"block\";\n\n    box.style.background =\n    `linear-gradient(135deg, ${data.color1}, ${data.color2})`;\n\n    box.innerHTML =\n    `${data.icon} ${data.message}`;\n\n    // voice alert only when state changes\n    if(lastState !== data.state){\n\n        if(data.state === \"Warning\"){\n            speakAlert(\"Warning. Please check health metrics\");\n        }\n\n        if(data.state === \"Critical\"){\n            speakAlert(\"Emergency detected\");\n        }\n    }\n\n    lastState = data.state;\n\n});\n\n})(scope);\n</script>",
