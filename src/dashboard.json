    {
        "id": "af1384c5e83048c2",
        "type": "ui_template",
        "z": "ca447f58e3bfd497",
        "group": "f81a482830b8ac9d",
        "name": "HR templete",
        "order": 2,
        "width": 0,
        "height": 0,
        "format": "<div style=\"\ndisplay:flex;\njustify-content:center;\nalign-items:center;\nheight:280px;\n\">\n\n<div class=\"heart-container\">\n\n    <div class=\"heart-icon\">💙</div>\n\n    <div class=\"heart-title\">Heart Rate</div>\n\n    <div class=\"heart-value\">\n        {{msg.payload || \"--\"}}\n    </div>\n\n    <div class=\"ecg-line\">\n        ──╲╱╲──\n    </div>\n\n    <div class=\"heart-bpm\">BPM</div>\n\n</div>\n\n</div>\n\n<style>\n.heart-container{\n    width:230px;\n    height:230px;\n    border-radius:50%;\n    \n    background: radial-gradient(circle at center,\n    #001a4d 20%,\n    #002b80 60%,\n    #003cff 100%);\n    \n    display:flex;\n    flex-direction:column;\n    justify-content:center;\n    align-items:center;\n    \n    color:white;\n    position:relative;\n\n    border:8px solid #35e0ff;\n\n    box-shadow:\n    0 0 20px rgba(53,224,255,0.35),\n    0 0 40px rgba(53,224,255,0.2);\n\n    animation: softPulse 2s infinite ease-in-out;\n}\n\n.heart-container::before{\n    content:\"\";\n    position:absolute;\n    width:250px;\n    height:250px;\n    border-radius:50%;\n    border:4px solid rgba(53,224,255,0.4);\n}\n\n.heart-icon{\n    font-size:30px;\n    margin-bottom:8px;\n}\n\n.heart-title{\n    font-size:20px;\n    font-weight:500;\n    margin-bottom:10px;\n}\n\n.heart-value{\n    font-size:60px;\n    font-weight:bold;\n    line-height:1;\n}\n\n.ecg-line{\n    font-size:22px;\n    color:#35e0ff;\n    margin-top:10px;\n}\n\n.heart-bpm{\n    font-size:18px;\n    color:#7ee8ff;\n    margin-top:5px;\n}\n\n@keyframes softPulse{\n    0%{\n        transform:scale(1);\n    }\n\n    50%{\n        transform:scale(1.03);\n    }\n\n    100%{\n        transform:scale(1);\n    }\n}\n</style>",
