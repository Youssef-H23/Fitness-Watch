    {
        "id": "b58da206117db06b",
        "type": "function",
        "z": "ca447f58e3bfd497",
        "name": "function 3",
        "func": "let hr = flow.get(\"hr\") || 70;\nlet spo2 = flow.get(\"spo2\") || 98;\n\nif (msg.topic === \"signals/hr\") {\n    hr = Number(msg.payload);\n    flow.set(\"hr\", hr);\n}\n\nif (msg.topic === \"signals/spo2\") {\n    spo2 = Number(msg.payload);\n    flow.set(\"spo2\", spo2);\n}\n\nlet status = {\n    state: \"Normal\"\n};\n\nif (hr > 100 || spo2 < 95) {\n    status = {\n        state: \"Warning\",\n        color1: \"#d97706\",\n        color2: \"#f59e0b\",\n        icon: \"⚠\",\n        message: \"Health Warning\"\n    };\n}\n\nif (hr > 120 || spo2 < 90) {\n    status = {\n        state: \"Critical\",\n        color1: \"#dc2626\",\n        color2: \"#ef4444\",\n        icon: \"🚨\",\n        message: \"Emergency Detected\"\n    };\n}\n\nmsg.payload = status;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
