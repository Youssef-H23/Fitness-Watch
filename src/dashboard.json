    {
        "id": "a01411c8599eac42",
        "type": "function",
        "z": "ca447f58e3bfd497",
        "name": "function 2",
        "func": "let steps = flow.get(\"steps\") || 0;\nlet weight = flow.get(\"weight\") || 70;\nlet state = flow.get(\"state\") || \"idle\";\nlet totalCalories = flow.get(\"totalCalories\") || 0;\n\nif (msg.topic === \"signals/steps\") {\n    steps = Number(msg.payload);\n    flow.set(\"steps\", steps);\n}\n\nif (msg.topic === \"weight\") {\n    let enteredWeight = Number(msg.payload);\n\n    if (!isNaN(enteredWeight) && enteredWeight > 20 && enteredWeight < 300) {\n        weight = enteredWeight;\n        flow.set(\"weight\", weight);\n    }\n}\n\nif (msg.topic === \"control/state\") {\n    state = msg.payload.toLowerCase();\n    flow.set(\"state\", state);\n}\n\nif (msg.topic === \"reset\") {\n    totalCalories = 0;\n    steps = 0;\n\n    flow.set(\"totalCalories\", 0);\n    flow.set(\"steps\", 0);\n    flow.set(\"previousSteps\", 0);\n\n    msg.payload = \"0.00\";\n    return msg;\n}\n\nif (msg.topic === \"timer\") {\n\n    let caloriesAdded = 0;\n    let previousSteps = flow.get(\"previousSteps\") || 0;\n\n    let newSteps = steps - previousSteps;\n\n    if (newSteps < 0) {\n        newSteps = 0;\n    }\n\n    // Active states\n    if (state.includes(\"walking\")) {\n        caloriesAdded = newSteps * weight * 0.0005;\n    }\n    else if (state.includes(\"running\")) {\n        caloriesAdded = newSteps * weight * 0.0010;\n    }\n\n    // Resting states\n    else if (state.includes(\"idle\")) {\n        caloriesAdded = weight * 0.00005;\n    }\n    else if (state.includes(\"sleep\")) {\n        caloriesAdded = weight * 0.00003;\n    }\n\n    totalCalories += caloriesAdded;\n\n    flow.set(\"previousSteps\", steps);\n}\nflow.set(\"totalCalories\", totalCalories);\n\nmsg.payload = totalCalories.toFixed(2);\n\nreturn msg;",
