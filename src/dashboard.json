    {
        "id": "cc893335afb10e2b",
        "type": "function",
        "z": "ca447f58e3bfd497",
        "name": "function 8",
        "func": "let rawMag = Number(msg.payload);\n\n// تقريب لجذر القيمة\nlet correctedMag = Math.sqrt(rawMag);\n\n// إزالة baseline الجاذبية التقريبية\ncorrectedMag = correctedMag - 9.8;\n\n// منع القيم السالبة\nif (correctedMag < 0) {\n    correctedMag = 0;\n}\n\nmsg.payload = correctedMag.toFixed(2);\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
