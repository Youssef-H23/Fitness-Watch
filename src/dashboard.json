    {
        "id": "12462bd72e1c1abe",
        "type": "ui_template",
        "z": "ca447f58e3bfd497",
        "group": "f81a482830b8ac9d",
        "name": "Current Activity",
        "order": 7,
        "width": 0,
        "height": 0,
        "format": "<div style=\"\ndisplay:flex;\njustify-content:center;\nalign-items:center;\nheight:260px;\n\">\n\n<div id=\"stateCard\" class=\"state-container\">\n\n    <div id=\"stateIcon\" class=\"state-icon\">🧍</div>\n\n    <div class=\"state-title\">\n        Current Activity\n    </div>\n\n    <div id=\"stateValue\" class=\"state-value\">\n        {{msg.payload || \"Idle\"}}\n    </div>\n\n</div>\n\n</div>\n\n<script>\n(function(scope){\n\nscope.$watch('msg', function(msg){\n\n    if(!msg || !msg.payload) return;\n\n    let state = msg.payload.toLowerCase();\n\n    let icon = \"🧍\";\n    let color1 = \"#475569\";\n    let color2 = \"#64748b\";\n\n    if(state.includes(\"walking\")){\n        icon=\"🚶\";\n        color1=\"#0f766e\";\n        color2=\"#14b8a6\";\n    }\n\n    else if(state.includes(\"running\")){\n        icon=\"🏃\";\n        color1=\"#b45309\";\n        color2=\"#f97316\";\n    }\n\n    else if(state.includes(\"sleep\")){\n        icon=\"😴\";\n        color1=\"#1e3a8a\";\n        color2=\"#3b82f6\";\n    }\n\n    else if(state.includes(\"idle\")){\n        icon=\"🧍\";\n        color1=\"#374151\";\n        color2=\"#6b7280\";\n    }\n\n    document.getElementById(\"stateIcon\").innerHTML = icon;\n\n    document.getElementById(\"stateCard\").style.background =\n    `linear-gradient(135deg, ${color1}, ${color2})`;\n\n});\n\n})(scope);\n</script>\n\n<style>\n.state-container{\n    width:220px;\n    height:220px;\n    border-radius:25px;\n    background:linear-gradient(135deg,#374151,#6b7280);\n\n    display:flex;\n    flex-direction:column;\n    justify-content:center;\n    align-items:center;\n\n    color:white;\n\n    box-shadow:0px 0px 20px rgba(0,0,0,0.2);\n}\n\n.state-icon{\n    font-size:40px;\n}\n\n.state-title{\n    font-size:20px;\n    margin:10px 0;\n}\n\n.state-value{\n    font-size:28px;\n    font-weight:bold;\n}\n</style>",
